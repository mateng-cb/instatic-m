# Per-site deployment env — copy to .env (git-ignored) and fill in.
# This file is THIS site's whole configuration: image tag, origin, secret.
# Other sites have their own copies in their own directories.

# Image tag for THIS site. Per-site tags enable graded rollouts: bump ditexpo
# first, smoke-test, then move the other sites. Keep sites aligned long-term.
INSTATIC_IMAGE=swr.ap-southeast-3.myhuaweicloud.com/idcnova/instatic:v1

# This site's CMS admin origin (Nginx + ELB front it; the container binds
# 127.0.0.1 only).
PUBLIC_ORIGIN=https://ditexpo-cms.idcnova.com

# Site secret key — encrypts stored credentials (e.g. the GitHub publish PAT).
# Generate once: openssl rand -base64 32
# Losing it makes stored secrets undecryptable; back it up with the site data.
INSTATIC_SECRET_KEY=
