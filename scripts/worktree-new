#!/usr/bin/env bash
# Create a git worktree under .worktrees/ from an up-to-date main.
# Usage: scripts/worktree-new <type>/<short-kebab-description>
# Example: scripts/worktree-new feat/double-click-rename
set -euo pipefail

branch="${1:?Usage: scripts/worktree-new <type>/<short-kebab-description>}"
name="${branch#*/}"
dir=".worktrees/${name}"

if [[ "$branch" != */* ]]; then
  echo "error: branch must be <type>/<short-kebab-description> (e.g. feat/double-click-rename)" >&2
  exit 1
fi
if git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "error: branch '$branch' already exists" >&2
  exit 1
fi
if [[ -e "$dir" ]]; then
  echo "error: '$dir' already exists" >&2
  exit 1
fi

git fetch origin main
git worktree add "$dir" -b "$branch" origin/main
echo "worktree ready: $dir (branch $branch, based on origin/main)"
